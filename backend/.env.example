# Copy to `.env` and fill in values. Loaded via dotenvx (`npm start`, seeds, tests).

# Core
MONGO_URI=
PORT=8920
NODE_ENV=development
JWT_SECRET=

# Frontend origin(s), comma-separated (emails + CORS + auth cookies)
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Admin bootstrap (first server start only, if no admin exists)
ADM_NAME=
ADM_EMAIL=
ADM_PASSWORD=

# Transactional email (Gmail App Password recommended)
EMAIL_USER=
EMAIL_PASS=
EMAIL_OWNER=

# Resume/permit AI (Google AI Studio API key)
# GEMINI_API_KEY=
# Primary model (verified with Google AI Studio generateContent). Fallbacks: 3.6/3.7/3.8-flash, gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash

# AWS S3 (optional — account deletion removes uploaded files when set)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# Account inactivity job (defaults shown)
# INACTIVITY_MONTHS=6
# ACCOUNT_CLEANUP=off          # set to off to disable daily auto-delete job
# ALLOW_MANUAL_INACTIVITY_JOB=true   # allow admin API to run job in production

# Seeds (test / demo only)
# SEED_DEMO_PASSWORD=
# SEED_CONFIRM_PRODUCTION=I_UNDERSTAND_THIS_WRITES_TO_PRODUCTION
# SEED_LIFECYCLE_BROADCAST_SECRET=  # optional; defaults to SEED_CONFIRM_PRODUCTION — refreshes open admin UI after seeds
# ALLOW_SEED_LIFECYCLE_BROADCAST=true  # required in production to enable POST /api/admin/inactivity/broadcast from seeds
# INACTIVITY_DEMO_EMAIL=
# INACTIVITY_DEMO_ACCOUNT_EMAIL=
# INACTIVITY_LIFECYCLE_INBOX=joav.zabala.up@phinmaed.com  # lifecycle email tour: inbox + backdates this worker/employer login for Admin UI
