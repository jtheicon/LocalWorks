# Copy to `.env` and fill in values. Loaded via dotenvx (`npm start`, seeds, tests).

# Core
MONGO_URI=
PORT=8920
NODE_ENV=development
JWT_SECRET=

# Frontend origin(s), comma-separated (emails + CORS + auth cookies)
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Admin bootstrap (first server start only, if no admin exists)
ADM_NAME=
ADM_EMAIL=
ADM_PASSWORD=

# Transactional email (Gmail App Password recommended)
EMAIL_USER=
EMAIL_PASS=
EMAIL_OWNER=

# Resume/permit AI (Google AI Studio API key)
# GEMINI_API_KEY=
# Primary model (verified with Google AI Studio generateContent). Fallbacks: 3.6/3.7/3.8-flash, gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash
# SIGNUP_AI_DEADLINE_MS=120000   # sign-up document AI (background job; default 120s)
# SIGNUP_DOCUMENT_MAX_MB=5       # max CV/resume & sign-up permit upload (default 5 MB; cap 50)

# AWS S3 (optional — account deletion removes uploaded files when set)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# Account inactivity job (defaults shown)
# INACTIVITY_MONTHS=6
# ACCOUNT_CLEANUP=off          # production: disable daily inactivity job
# ACCOUNT_CLEANUP=on           # development: opt in to startup/daily job (default off when NODE_ENV≠production)
# ALLOW_MANUAL_INACTIVITY_JOB=true   # allow admin API to run job in production

# Seeds (test / demo only; set both before any --apply or --reset)
# SEED_DEMO_PASSWORD=replace-with-a-temporary-password-at-least-8-characters
# SEED_CONFIRM_PRODUCTION=I_UNDERSTAND_THIS_WRITES_TO_PRODUCTION
# SEED_LIFECYCLE_BROADCAST_SECRET=  # optional; defaults to SEED_CONFIRM_PRODUCTION — refreshes open admin UI after seeds
# ALLOW_SEED_LIFECYCLE_BROADCAST=true  # required in production to enable POST /api/admin/inactivity/broadcast from seeds
# INACTIVITY_DEMO_EMAIL=
# INACTIVITY_DEMO_ACCOUNT_EMAIL=
# INACTIVITY_LIFECYCLE_INBOX=notify@example.com  # required for email tour --apply; all warning/deletion mail goes here
# INACTIVITY_LIFECYCLE_ACCOUNT_EMAIL=worker-login@example.com  # optional; platform account to backdate when login ≠ inbox
# SEED_BACKDATE_LIFECYCLE_INBOX=I_UNDERSTAND_THIS_BACKDATES_THE_CONFIGURED_LIFECYCLE_INBOX_ACCOUNT  # required for individual warning-stage tests
# SEED_DELETE_LIFECYCLE_INBOX=I_UNDERSTAND_THIS_DELETES_THE_CONFIGURED_LIFECYCLE_INBOX_ACCOUNT  # required only for the destructive inbox deletion test
